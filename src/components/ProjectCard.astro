---
interface Props {
  id: string;
  name: string;
  // description: string;
  // year: number;
  alt?: string;

  techStack: string[];
  // services: string[];
  card: string;

  // banner?: string;
  // gallery?: string[];
}

const { card, alt, name, techStack, id } = Astro.props as Props;
---

<a href={`/projektek/${id}`} class="block hover:opacity-90 transition">
  <div class="overflow-hidden rounded-3xl shadow-xl">
    <img
      src={card}
      alt={alt}
      class="w-full h-auto rounded-3xl object-cover"
      loading="lazy"
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
    />
  </div>
  <div class="flex flex-wrap gap-2 mt-4 text-sm text-primary-text">
    {techStack.map((tech: string) => <span>{tech}</span>)}
  </div>
  <h1 class="text-xl font-bold mt-2">{name}</h1>
</a>
