---
import Hero from '../components/Hero.astro';
import Layout from '../layouts/Layout.astro';
import Services from '../components/Services.astro';
import Workflow from '../components/Workflow.astro';
import ArrowScrollDown from '../components/ArrowScrollDown.astro';

import Packages from '../components/Packages.astro';
import ContactForm from '../components/ContactForm.astro';
import ProjectList from '../components/ProjectList.astro';
import Action from '../components/Action.astro';
import WhyMe from '../components/WhyMe.astro';
import FAQList from '../components/FAQList.astro';
import AnimatedText from '../components/AnimatedText.astro';
import CTA from '../components/CTA.astro';
import Book from '../components/Book.astro';

const title = 'Agnesnora Studio Webfejlesztés';
const description =
  'Webfejlesztés, webapp-ok, dashboardok, weboldalak audit Next.js, Astro, React, Tailwind, SCSS technológiákkal.';
const canonical = 'https://agnesnorastudio.hu/';
---

<Layout {title} {canonical} {description}>
  <div>
    <Hero />
    <AnimatedText />
    <WhyMe />

    <Services />

    <Workflow />

    <Packages />
    <Action />

    <section id="legutobbi-munkaim">
      <ArrowScrollDown title="Legutóbbi munkáim" />
    </section>
    <ProjectList id="projektek" />
    <CTA />
    <FAQList />
    <section id="kapcsolat">
      <ArrowScrollDown title="Lépj kapcsolatba velem!" />
    </section>
    <ContactForm />
    <Book />
  </div>
</Layout>
