---
import Hero from '../components/Hero.astro';
import Layout from '../layouts/Layout.astro';
import Services from '../components/Services.astro';
import Workflow from '../components/Workflow.astro';
import ArrowScrollDown from '../components/ArrowScrollDown.astro';

import Packages from '../components/Packages.astro';
import ContactForm from '../components/ContactForm.astro';
import ProjectList from '../components/ProjectList.astro';
import Action from '../components/Action.astro';
import WhyMe from '../components/WhyMe.astro';
---

<div class="w-full bg-primary-bg">
  <Layout>
    <div>
      <Hero />
      <WhyMe />
      <Services />

      <Workflow />
      <p>
        Profi weboldalak és webalkalmazások minden vállalkozásnak rugalmas
        csomagokban.
      </p>
      <Packages />
      <Action />
      <section id="legutobbi-munkaim">
        <ArrowScrollDown title="Legutóbbi munkáim" />
      </section>
      <ProjectList id="projektek" />
      <section id="kapcsolat">
        <ArrowScrollDown title="Lépj kapcsolatba velem!" />
      </section>
      <ContactForm />
    </div>
  </Layout>
</div>
