---
import ArrowScrollDown from './ArrowScrollDown.astro';

const workflowSteps = [
  {
    id: '01',
    title: 'Kutatás',
    description:
      'Célok, felhasználói utak, versenytársak és szükséges funkciók részletes feltérképezése. Megértem, kinek készül az oldal és hogyan használják majd, hogy a projekt biztos alapokra épüljön.',
  },
  {
    id: '02',
    title: 'Tervezés',
    description:
      'Az oldal felépítését, struktúráját és működési logikáját közösen alakítjuk ki. Így minden egyszerűen átlátható, és a későbbi fejlesztés is gördülékeny lesz.',
  },
  {
    id: '03',
    title: 'Dizájn',
    description:
      'Wireframe-ek és vizuális hierarchia kialakítása, modern, reszponzív megjelenéssel. Olyan dizájnt készítek, ami letisztult, könnyen használható és a márkádhoz illeszkedik.',
  },
  {
    id: '04',
    title: 'Fejlesztés',
    description:
      'Next.js, Astro és React alapú fejlesztés. Gyors, stabil és SEO-barát weboldal vagy webapp, moduláris felépítéssel, amely később könnyen bővíthető.',
  },
  {
    id: '05',
    title: 'Átadás',
    description:
      'Tesztelés, végső simítások, deploy és dokumentáció. Biztosítom, hogy minden zökkenőmentesen működjön, és az oldal könnyen kezelhető legyen a továbbiakban.',
  },
];
---

<div class="w-full bg-white">
  <ArrowScrollDown title="Hogyan dolgozom?" />
  <div
    class="w-5/6 px-2 max-w-7xl lg:px-4 py-24 mt-16 mx-auto bg-white grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 rounded-2xl"
  >
    {
      workflowSteps.map((step) => (
        <div class=" mb-8  lg:mb-16 ">
          <p class="font-family-space text-9xl">{step.id}</p>
          <h3 class=" font-light mb-16 text-4xl">{step.title}</h3>
          <p class="text-lg leading-relaxed">{step.description}</p>
        </div>
      ))
    }
  </div>
</div>
