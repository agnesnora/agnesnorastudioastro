---
import Hero from '../components/Hero.astro';
import Layout from '../layouts/Layout.astro';
import Services from '../components/Services.astro';
import Workflow from '../components/Workflow.astro';
import ArrowScrollDown from '../components/ArrowScrollDown.astro';

import Packages from '../components/Packages.astro';
import ContactForm from '../components/ContactForm.astro';
import ProjectList from '../components/ProjectList.astro';
import IconCard from '../components/IconCard.astro';
---

<div class="w-full bg-primary-bg">
  <Layout>
    <div>
      <Hero />
      <IconCard />
      <Services />
      <ArrowScrollDown title="Hogyan dolgozom?" />
      <Workflow />
      <p>
        Profi weboldalak és webalkalmazások minden vállalkozásnak rugalmas
        csomagokban.
      </p>
      <Packages />
      <ArrowScrollDown title="Legutóbbi munkáim" />
      <ProjectList />
      <ContactForm />
    </div>
  </Layout>
</div>
