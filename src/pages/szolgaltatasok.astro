---
import LongServiceCard from '../components/LongServiceCard.astro';
import Layout from '../layouts/Layout.astro';
import data from '../data/services.json';
---

<Layout>
  <section class="max-w-7xl mx-auto mt-32 mb-32">
    <h1
      class="font-family-space font-bold mb-32 text-3xl text-center px-4 lg:text-4xl xl:text-5xl"
    >
      Szolgáltatások
    </h1>
    <LongServiceCard services={data.services} />
  </section>
</Layout>
