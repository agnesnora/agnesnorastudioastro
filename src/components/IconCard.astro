---
const { imageSrc, alt, cardTitle, description } = Astro.props;
---

<div
  class="bg-primary-bg p-6 rounded-3xl text-center flex flex-col items-center gap-4"
>
  <img src={imageSrc} alt={alt} class="w-32 h-32 object-cover" loading="lazy" />
  <h1 class="font-family-space font-bold text-xl">{cardTitle}</h1>
  <p class="w-5/6 font-family-poppins text-sm">
    {description}
  </p>
</div>
