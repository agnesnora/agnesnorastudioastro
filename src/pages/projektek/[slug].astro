---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout>
  <div class="w-full flex flex-col items-start pl-8 my-24">
    <h1
      class="text-3xl font-family-space text-left font-bold text-dark-bg mb-4"
    >
      {project.name}
    </h1><p>{project.year}</p>
  </div>
  <img
    src={project.imageSrc}
    alt={project.alt}
    class="w-full mx-auto mb-8 xl:w-4xl"
  />

  <!-- <div class="flex gap-2 mb-8">
      {
        project.techStack.map((tech) => (
          <span class="bg-sage-bg-light text-primary-text text-sm px-3 py-1 rounded-full">
            {tech}
          </span>
        ))
      }
    </div> -->
  <div class="mt-12 bg-primary-bg text-secondary-bg">
    <h2 class="text-sm uppercase">Szolgáltatások</h2>
    <ul>
      {project.services?.map((tech) => <li>{tech}</li>)}
    </ul>
  </div>

  <div class="prose prose-lg max-w-none">
    <p class="text-primary-text leading-relaxed">
      {project.description}
    </p>
  </div>
</Layout>
