---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';
const { title, description, canonical } = Astro.props;
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <meta
      name="google-site-verification"
      content="yWiJ6eaxMcXfDmz8PSDlY7H6AJydpXZb4fj5_zLLolc"
    />
    <link rel="icon" href="/favicon.ico" />
  
    <meta name="generator" content={Astro.generator} />
    
    <!-- OpenGraph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="/fb.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Agnes Nora Studio" />
    
    {import.meta.env.PROD && (
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag() {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', 'G-H4187EYG0D');

        const loadGtag = () => {
          if (document.querySelector('script[data-gtag="true"]')) return;
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-H4187EYG0D';
          s.dataset.gtag = 'true';
          document.head.appendChild(s);
        };

        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadGtag, { timeout: 2000 });
        } else {
          setTimeout(loadGtag, 1);
        }
      </script>
    )}
    

   
    <link rel="dns-prefetch" href="https://web3forms.com" />
  
  </head>
  <body>
    <Header />
    <main class="mx-auto">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow-x: hidden;
  }
</style>