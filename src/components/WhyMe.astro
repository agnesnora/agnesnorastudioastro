---
import IconCard from './IconCard.astro';
---

<div class="w-full bg-secondary-bg px-8 py-32 md:p-16 text-primary-text">
  <h1 class="font-family-space font-bold text-3xl text-center mb-12">
    Miért dolgozz velem?
  </h1>
  <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8">
    <IconCard
      imageSrc="/Wallet.webp"
      alt="Pénztárca ikon"
      cardTitle="Költséghatékonyság"
      description="A vállalkozásod többet érdemel egy sablonnál. Tűnj ki egy olyan egyedi megjelenéssel, amely valóban megszólítja a felhasználóidat."
    />
    <IconCard
      imageSrc="/UI UX.webp"
      alt="Dizájn ikon"
      cardTitle="Egyedi reszponzív dizájn"
      description="A vállalkozásod többet érdemel egy sablonnál. Tűnj ki egy olyan egyedi megjelenéssel, amely valóban megszólítja a felhasználóidat."
    />
    <IconCard
      imageSrc="/Rocket.webp"
      alt="Rakéta ikon"
      cardTitle="Gyorsaság, SEO, Teljesítmény"
      description="A vállalkozásod többet érdemel egy sablonnál. Tűnj ki egy olyan egyedi megjelenéssel, amely valóban megszólítja a felhasználóidat."
    />
  </div>
</div>
