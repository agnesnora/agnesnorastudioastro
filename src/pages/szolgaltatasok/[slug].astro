---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/services.json';
import CTA from '../../components/CTA.astro';

// type Service = {
//   id: number;
//   title: string;
//   description: string;
//   features: string[];
//   forWho: string;
//   bgColor: string;
//   color: string;
//   longDescription: string;
//   longFeatures: string[];
//   slug?: string;
// };

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
  }));
}
const { slug } = Astro.params;
const service = services.find((s) => s.slug === slug);

if (!service) {
  throw new Error('Service not found');
}
---

<Layout>
  <section class=`w-full mt-12 mx-auto`>
    <div
      class="w-full mx-auto h-lg px-4 md:px-8 lg:px-12 bg-sage-bg-light pt-16 lg:pt-32 pb-16"
    >
      <div class="max-w-7xl mx-auto text-left">
        <h1
          class="font-family-poppins text-primary-text font-black uppercase text-5xl xl:text-6xl 2xl:text-9xl mb-4"
        >
          {service.title}
        </h1>
        <h2
          class="text-3xl leading-12 lg:text-4xl xl:text-7xl py-3 lg:leading-24 lg:py-8 font-family-poppins font-black bg-linear-to-r from-teal-700 to-gray-700 bg-clip-text text-transparent"
        >
          {service.longTitle}
        </h2>
        <h3
          class="max-w-2xl lg:max-w-4xl my-12 text-xl lg:text-2xl xl:text-3xl font-family-inter font-bold"
        >
          {service.hero}
        </h3>
        <a
          href="#kapcsolat"
          class="relative h-12 lg:h-16 px-4 lg:px-8 py-8 mt-8 text-center justify-center md:justify-self-end rounded-2xl text-lg lg:text-xl font-black bg-dark-bg text-white flex items-center gap-3 overflow-hidden group transform transition-transform duration-300 hover:scale-105"
        >
          <!-- szöveg + ikon -->
          <span class="relative z-10 flex items-center gap-3">
            Beszéljünk a projektedről!
            <span
              class="hidden w-10 h-10 sm:flex items-center justify-center bg-white rounded-full"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="#3F5F59"
              >
                <path
                  d="m14 18-1.4-1.45L16.15 13H4v-2h12.15L12.6 7.45 14 6l6 6z"
                ></path>
              </svg>
            </span>
          </span>

          <!-- sweep layer -->
          <span
            class="absolute inset-0 bg-white opacity-30 rotate-45 -translate-x-full group-hover:translate-x-full blur-sm transition-transform duration-500"
          ></span>
        </a>
      </div>
    </div>

    <div class="w-full max-w-7xl mx-auto my-32">
      <h2
        class="relative mx-4 sm:mx-6 lg:mx-12 inline-block text-4xl lg:text-6xl font-black font-family-space text-primary-text my-16"
      >
        <span class="relative z-10">Miben segítek?</span>
        <span class="absolute left-0 bottom-2 w-full h-5 bg-secondary-bg z-0"
        ></span>
      </h2>
      <ul class="flex justify-center flex-wrap gap-8">
        {
          service.longFeatures.map((feature) => (
            <li class="w-72 text-xl p-8 items-center bg-sage-bg-light/50 rounded-2xl  font-bold font-family-space text-primary-text">
              {feature}
            </li>
          ))
        }
      </ul>
      <div
        class="text-secondary-text bg-primary-text px-4 lg:px-8 py-12 my-24 xl:rounded-4xl"
      >
        <h2
          class="relative text-4xl inline-block lg:text-6xl lg:px-6 font-bold lg:font-black font-family-space my-8 lg:my-16"
        >
          <span class="relative z-10">Hogyan dolgozom?</span>
          <!-- <span
            class="absolute left-0 bottom-2 w-full bg-button-primary h-5 z-0"
          ></span> -->
        </h2>
        <p
          class="max-w-5xl leading-9 lg:leading-12 text-xl lg:text-3xl font-family-inter font-black
         text-secondary-text"
        >
          {service.how}
        </p>
      </div>
      <section class="mb-24">
        <h2
          class="relative mx-4 sm:mx-6 lg:mx-12 inline-block text-4xl lg:text-6xl font-black font-family-space text-primary-text my-4 lg:my-16"
        >
          <span class="relative z-10">Kinek ajánlom? Neked, ha</span>
          <span
            class="absolute left-0 bottom-2 w-full h-5 bg-button-hover opactity-40 z-0"
          ></span>
        </h2>
        <ul class="mx-auto px-6 list-disc list-inside">
          {
            service.forWho.map((feature) => (
              <li class="text-xl lg:text-3xl font-family-inter font-bold lg:font-black py-2 text-primary-text ">
                {feature}
              </li>
            ))
          }
        </ul>
      </section>

      <div
        class="w-full px-4 lg:px-12 py-16 lg:py-24 lg:my-32 lg:rounded-2xl max-w-7xl lg:p-32 h-130 md:h-100 lg:h-150 mx-auto bg-linear-to-r from-gray-800 to-teal-600 text-white grid grid-cols-1"
      >
        <h1
          class="font-black text-2xl md:text-4xl leading-10 md:leading-12 lg:leading-16 xl:text-5xl mb-4"
        >
          {service.CTA}
        </h1>
        <!-- <p class="font-black text-2xl xl:text-4xl">Dolgozzunk rajta együtt.</p> -->
        <a
          href="#kapcsolat"
          class="relative h-12 lg:h-16 px-4 py-8 lg:px-8 mt-8 rounded-2xl justify-self-end text-center font-family text-xl font-black bg-dark-bg text-white flex items-center gap-3 overflow-hidden group transform transition-transform duration-300 hover:scale-105"
        >
          <!-- szöveg + ikon -->
          <span class="relative z-10 flex items-center gap-3">
            Beszéljünk a projektedről!
            <span
              class="hidden w-10 h-10 sm:flex text-center items-center justify-center bg-white rounded-full"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="#3F5F59"
              >
                <path
                  d="m14 18-1.4-1.45L16.15 13H4v-2h12.15L12.6 7.45 14 6l6 6z"
                ></path>
              </svg>
            </span>
          </span>

          <!-- sweep layer -->
          <span
            class="absolute inset-0 bg-white opacity-30 rotate-45 -translate-x-full group-hover:translate-x-full blur-sm transition-transform duration-500"
          ></span>
        </a>
      </div>
    </div>
  </section>
</Layout>
