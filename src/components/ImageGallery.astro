---
type Props = {
  images: { src: string; alt?: string }[];
};

const { images } = Astro.props;
---

<div class="w-full mx-auto lg:w-4xl xl:w-7xl px-4">
  <div class="grid gap-6 lg:gap-12 sm:grid-cols-2">
    {
      images.map((img) => (
        <div class="overflow-hidden rounded-2xl bg-neutral-100">
          <img
            src={img.src}
            alt={img.alt ?? ''}
            width="800"
            height="600"
            class="w-full h-auto object-contain"
            loading="lazy"
          />
        </div>
      ))
    }
  </div>
</div>
