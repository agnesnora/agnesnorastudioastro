<h1
  class="uppercase text-3xl text-center font-family-poppins font-black m-8 lg:text-4xl xl:text-5xl"
>
  Indítsuk el a projekted
</h1>
<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="w-4/5 max-w-2xl lg:w-1/2 mx-auto text-center flex flex-col items-center"
>
  <!-- Web3Forms Access Key - cseréld ki a sajátodra! -->
  <input
    type="hidden"
    name="access_key"
    value="6ca95b49-b2f7-4905-b105-47401937c473"
  />

  <!-- Redirect after submit -->
  <input
    type="hidden"
    name="redirect"
    value="https://agnesnorastudioastro.vercel.app/koszonom"
  />

  <!-- Honeypot Spam Protection -->
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display: none;"
  />

  <input
    name="name"
    type="text"
    placeholder="Név"
    required
    class="w-full border-0 border-b border-primary-text bg-transparent
         py-4 outline-none focus:border-button-primary"
  />

  <input
    name="email"
    type="email"
    placeholder="Email"
    class="w-full border-0 border-b border-primary-text bg-transparent
         py-4 outline-none focus:border-button-primary"
    required
  />

  <textarea
    name="message"
    class="w-full border-0 border-b border-primary-text bg-transparent
         py-4 outline-none resize-none focus:border-button-primary"
    placeholder="Írj nekem a projektedről"
    rows="5"
    required
    minlength="10"></textarea>
  <!-- <div class="h-captcha mt-4" data-captcha="true"></div> -->

  <button
    type="submit"
    class="w-full my-12 text-primary-text bg-button-primary hover:bg-button-hover font-bold py-4 rounded-2xl tracking-wide"
  >
    Üzenet elküldése
  </button>
</form><div class="flex flex-col mx-auto">
  <h3 class="text-center">
    Ha szeretnél azonnal időpontot foglalni, kattints a gombra!
  </h3>
  <a
    href="https://tidycal.com/agnesnorastudio/30-minute-meeting"
    class="relative px-8 mx-auto py-8 mt-8 rounded-2xl block bg-dark-bg text-white text-center group transform transition-transform duration-300 hover:scale-105"
  >
    <!-- szöveg + ikon -->
    <span class="relative z-10 flex items-center gap-3">
      Foglalj időpontot!
      <span
        class="w-10 h-10 flex items-center justify-center bg-white rounded-full"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="#3F5F59"
        >
          <path d="m14 18-1.4-1.45L16.15 13H4v-2h12.15L12.6 7.45 14 6l6 6z"
          ></path>
        </svg>
      </span>
    </span>

    <!-- sweep layer -->
    <span
      class="absolute inset-0 bg-white opacity-30 rotate-45 -translate-x-full group-hover:translate-x-full blur-sm transition-transform duration-500"
    ></span>
  </a>
</div>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const s = document.createElement('script');
          s.src = 'https://web3forms.com/client/script.js';
          s.async = true;
          document.body.appendChild(s);
          observer.disconnect();
        }
      });
    },
    { rootMargin: '200px' }
  );

  const form = document.querySelector('form[action*="web3forms"]');
  if (form) observer.observe(form);
</script>
