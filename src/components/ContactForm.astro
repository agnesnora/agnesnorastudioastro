<h1 class="uppercase text-3xl text-center font-family-poppins font-black m-8">
  Indítsuk el a projekted
</h1>
<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="w-4/5 lg:w-1/2 mx-auto text-center flex flex-col items-center"
>
  <!-- Web3Forms Access Key - cseréld ki a sajátodra! -->
  <input
    type="hidden"
    name="access_key"
    value="6ca95b49-b2f7-4905-b105-47401937c473"
  />

  <!-- Redirect after submit -->
  <input
    type="hidden"
    name="redirect"
    value="https://agnesnorastudioastro.vercel.app/koszonom"
  />

  <!-- Honeypot Spam Protection -->
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display: none;"
  />

  <input
    name="name"
    type="text"
    placeholder="Név"
    required
    class="w-full border-0 border-b border-primary-text bg-transparent
         py-4 outline-none focus:border-button-primary"
  />

  <input
    name="email"
    type="email"
    placeholder="Email"
    class="w-full border-0 border-b border-primary-text bg-transparent
         py-4 outline-none focus:border-button-primary"
    required
  />

  <textarea
    name="message"
    class="w-full border-0 border-b border-primary-text bg-transparent
         py-4 outline-none resize-none focus:border-button-primary"
    placeholder="Írj nekem a projektedről"
    rows="5"
    required
    minlength="10"></textarea>

  <button
    type="submit"
    class="w-full my-12 text-primary-text bg-button-primary hover:bg-button-hover font-bold py-4 rounded-2xl tracking-wide"
  >
    Üzenet elküldése
  </button>
</form>
