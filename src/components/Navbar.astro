---
const links = [
  { href: '/', label: 'Főoldal' },
  // { href: '/rolam', label: 'Rólam' },
  { href: '/#legutobbi-munkaim', label: 'Munkáim' },
  { href: '/#kapcsolat', label: 'Kapcsolat' },
  { href: '/#arak', label: 'Árak' },
  { href: '/blog', label: 'Blog' },
  {
    href: 'https://tidycal.com/agnesnorastudio/30-minute-meeting',
    label: 'Időpontfoglalás',
  },
];
---

<header
  class="p-2 mx-auto w-full lg:w-3/4 max-w-7xl sticky top-0 lg:top-6 z-50 shadow-md bg-white/98 lg:rounded-4xl text-primary-text"
>
  <div class="mx-auto flex h-16 items-center justify-between px-4">
    <!-- Logo -->
    <a href="/"
      ><img
        src="/Agnesnora.svg"
        alt="Ágnes Nora Studio logó"
        class="h-18 w-auto"
      />
    </a>

    <!-- Desktop nav -->

    <nav class="hidden items-center gap-6 lg:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="relative group text-md font-regular p-2 font-family-poppins hover:text-rose-700 transition"
          >
            <span class="relative z-10">{l.label}</span>
            <span class="absolute left-2 bottom-0 w-full h-0.5 bg-button-primary opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-0" />
          </a>
        ))
      }
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="menuBtn"
      class="lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-xl text-primary-text"
      aria-label="Menü megnyitása"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <!-- hamburger icon -->
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
        <path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile menu overlay -->
  <div id="overlay" class="fixed inset-0 z-50 hidden bg-black/50"></div>

  <!-- Mobile sidebar -->
  <aside
    id="mobileMenu"
    class="fixed left-0 top-0 z-50 h-dvh w-full -translate-x-full bg-linear-to-r from-gray-700 to-teal-900 text-white transition-transform duration-200 ease-out"
    aria-hidden="true"
    inert
  >
    <div class="flex h-16 pt-8 items-center justify-between px-4">
      <a href="/"
        ><img
          src="/agnesnorawhite.svg"
          alt="Ágnes Nora Studio logó"
          class="h-15 pt-4 pl-8 w-auto"
        />
      </a>
      <button
        id="closeBtn"
        class="inline-flex h-10 w-10 items-center justify-center text-white text-lg"
        aria-label="Menü bezárása"
      >
        <!-- X icon -->
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path
            d="M6 6l12 12M18 6L6 18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <nav class="flex flex-col gap-1 p-3 mt-16">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="rounded-xl px-3 py-3 text-2xl  hover:bg-sage-bg-light hover:text-primary-text transition"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </aside>

  <script>
    /** @type {HTMLButtonElement | null} */
    const menuBtn = document.getElementById('menuBtn');
    /** @type {HTMLButtonElement | null} */
    const closeBtn = document.getElementById('closeBtn');
    /** @type {HTMLElement | null} */
    const overlay = document.getElementById('overlay');
    /** @type {HTMLElement | null} */
    const mobileMenu = document.getElementById('mobileMenu');

    const isMenuOpen = () => menuBtn?.getAttribute('aria-expanded') === 'true';

    const getFirstFocusableInMenu = () => {
      if (!mobileMenu) return null;
      return mobileMenu.querySelector(
        'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
      );
    };

    const openMenu = () => {
      if (!overlay || !mobileMenu || !menuBtn) {
        return;
      }
      overlay.classList.remove('hidden');
      mobileMenu.classList.remove('-translate-x-full');
      menuBtn.setAttribute('aria-expanded', 'true');
      mobileMenu.setAttribute('aria-hidden', 'false');
      mobileMenu.removeAttribute('inert');
      document.body.style.overflow = 'hidden';

      const el = getFirstFocusableInMenu();
      if (el instanceof HTMLElement) {
        // Ensure focus happens after classes/attributes are applied.
        setTimeout(() => el.focus(), 0);
      }
    };

    const closeMenu = () => {
      if (!overlay || !mobileMenu || !menuBtn) return;
      overlay.classList.add('hidden');
      mobileMenu.classList.add('-translate-x-full');
      menuBtn.setAttribute('aria-expanded', 'false');
      mobileMenu.setAttribute('aria-hidden', 'true');
      mobileMenu.setAttribute('inert', '');
      document.body.style.overflow = '';

      if (typeof menuBtn.focus === 'function') {
        setTimeout(() => menuBtn.focus(), 0);
      }
    };

    menuBtn?.addEventListener('click', () => {
      if (isMenuOpen()) closeMenu();
      else openMenu();
    });
    closeBtn?.addEventListener('click', () => {
      closeMenu();
    });
    overlay?.addEventListener('click', closeMenu);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isMenuOpen()) closeMenu();
    });

    mobileMenu?.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const a = target.closest('a');
      if (a) closeMenu();
    });
  </script>
</header>
