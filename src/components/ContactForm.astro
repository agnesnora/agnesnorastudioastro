<h1
  class="uppercase text-3xl text-center font-family-poppins font-black m-8 lg:text-4xl xl:text-5xl"
>
  Indítsuk el a projekted
</h1>
<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="w-4/5 max-w-2xl lg:w-1/2 mx-auto text-center flex flex-col items-center"
>
  <!-- Web3Forms Access Key - cseréld ki a sajátodra! -->
  <input
    type="hidden"
    name="access_key"
    value="6ca95b49-b2f7-4905-b105-47401937c473"
  />

  <!-- Redirect after submit -->
  <input
    type="hidden"
    name="redirect"
    value="https://agnesnorastudio.hu/koszonom"
  />

  <!-- Honeypot Spam Protection -->
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display: none;"
  />

  <input
    name="name"
    type="text"
    placeholder="Név"
    required
    class="w-full border-0 border-b border-primary-text bg-transparent
         py-4 outline-none focus:border-button-primary"
  />

  <input
    name="email"
    type="email"
    placeholder="Email"
    class="w-full border-0 border-b border-primary-text bg-transparent
         py-4 outline-none focus:border-button-primary"
    required
  />

  <textarea
    name="message"
    class="w-full border-0 border-b border-primary-text bg-transparent
         py-4 outline-none resize-none focus:border-button-primary"
    placeholder="Írj nekem a projektedről"
    rows="5"
    required
    minlength="10"></textarea>
  <!-- <div class="h-captcha mt-4" data-captcha="true"></div> -->

  <button
    type="submit"
    class="relative w-full my-12 text-primary-bg cursor-pointer text-xl font-black bg-gray-900 py-4 rounded-2xl tracking-wide overflow-hidden group"
  >
    <!-- Sweep layer -->
    <span
      class="absolute inset-0 bg-white opacity-30 rotate-45 -translate-x-full group-hover:translate-x-full blur-sm transition-transform duration-500"
    ></span>

    <!-- Szöveg -->
    <span class="relative z-10">Üzenet elküldése</span>
  </button>
</form>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const s = document.createElement('script');
          s.src = 'https://web3forms.com/client/script.js';
          s.async = true;
          document.body.appendChild(s);
          observer.disconnect();
        }
      });
    },
    { rootMargin: '200px' }
  );

  const form = document.querySelector<HTMLFormElement>(
    'form[action*="web3forms"]'
  );

  if (form) {
    const button = form.querySelector<HTMLButtonElement>(
      "button[type='submit']"
    );

    form.addEventListener('submit', () => {
      if (button) {
        button.disabled = true;
        button.classList.add('opacity-50', 'cursor-not-allowed');
        button.innerHTML = 'Küldés...';
      }
    });
  }
</script>
