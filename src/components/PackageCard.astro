---
const accentMap = {
  sage: 'text-sage-bg-light',
  rose: 'text-rose-bg',
  yellow: 'text-yellow-bg',
} as const;

const {
  accent,
  accentClass: accentClassProp,
  title,
  description,
  price,
  features,
} = Astro.props;

const accentClass =
  accentClassProp ??
  accentMap[accent as keyof typeof accentMap] ??
  accentMap.sage;

const maskId = `mask-${String(title).trim().toLowerCase().replace(/\s+/g, '-')}`;
---

<div
  class="relative
  flex
  flex-col
  h-full
  w-full
  min-h-150
  group
  min-w-[360]"
>
  <div class="absolute inset-0 z-0">
    <svg
      viewBox="0 0 370 921"
      xmlns="http://www.w3.org/2000/svg"
      class={`w-full h-full transition-colors duration-300 ${accentClass}`}
      preserveAspectRatio="none"
    >
      <path d="M0 0H213L223.5 39.4893H370V921H0V0Z" fill="white"></path>

      <mask id={maskId} fill="white">
        <path d="M0 0H213L223.5 39.4893H370V921H0V0Z"></path>
      </mask>
      <path
        d="M0 0V-10H-10V0H0ZM213 0L222.664 -2.56966L220.689 -10H213V0ZM223.5 39.4893L213.836 42.0589L215.811 49.4893H223.5V39.4893ZM370 39.4893H380V29.4893H370V39.4893ZM370 921V931H380V921H370ZM0 921H-10V931H0V921ZM0 0V10H213V0V-10H0V0ZM213 0L203.336 2.56966L213.836 42.0589L223.5 39.4893L233.164 36.9196L222.664 -2.56966L213 0ZM223.5 39.4893V49.4893H370V39.4893V29.4893H223.5V39.4893ZM370 39.4893H360V921H370H380V39.4893H370ZM370 921V911H0V921V931H370V921ZM0 921H10V0H0H-10V921H0Z"
        fill="currentColor"
        mask={`url(#${maskId})`}></path>
    </svg>
  </div>

  <div class="relative z-10 p-8 pt-16 flex flex-col h-full">
    <h2 class="text-2xl font-bold tracking-wider">{title}</h2>
    <p class="text-sm opacity-80 mt-2 min-h-12">{description}</p>

    <div class="my-6">
      <span class="text-3xl font-black">{price}</span>
    </div>

    <ul
      class="grow space-y-3 mb-8 font-family-poppins divide-y divide-gray-300"
    >
      {
        features.map((item: string) => (
          <li class="flex items-start gap-4 text-lg p-4 font-light">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
            >
              <path
                fill="1C1D19"
                d="M17.073 12.5H5.5q-.213 0-.357-.143T5 12t.143-.357t.357-.143h11.573l-3.735-3.734q-.146-.147-.152-.345t.152-.363q.166-.166.357-.168t.357.162l4.383 4.383q.13.13.183.267t.053.298t-.053.298t-.183.268l-4.383 4.382q-.146.146-.347.153t-.367-.159q-.16-.165-.162-.354t.162-.354z"
              />
            </svg>
            <p>{item}</p>
          </li>
        ))
      }
    </ul>

    <button
      class="w-full py-3 px-6 bg-dark-bg text-secondary-text font-bold rounded hover:bg-opacity-80 transition-all"
    >
      Ingyenes árajánlat
    </button>
  </div>
</div>
