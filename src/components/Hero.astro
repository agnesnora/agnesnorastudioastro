---
import AnimatedHeroText from './AnimatedHeroText.tsx';
---

<div class="w-full">
  <section class="px-6 py-12 lg:p-48">
    <h1
      class="py-20 text-right font-light font-family-poppins text-4xl leading-16 lg:text-left lg:text-6xl"
    >
      Weboldalak és webappok. <br /> Egyedileg. Úgy, ahogy szeretnéd.
    </h1>
    <div class="flex flex-col">
      <div
        class="flex flex-col items-center md:items-start md:ml-auto md:w-fit"
      >
        <p
          class="text-left mb-6 font-family-space md:text-left md:leading-7 lg:text-xl lg:leading-9"
        >
          Letisztult dizájn és megbízható technológia <br
            class="hidden lg:block"
          /> gondoskodik róla, hogy a webes megoldásod <br
            class="hidden lg:block"
          /> ne csak szép legyen, hanem teljesítsen is.
        </p>

        <a
          class="block w-fit p-4 bg-button-primary text-center rounded-md font-bold font-family-inter"
          href="#contact"
        >
          Beszéljünk a projektedről!
        </a>
      </div>
    </div>
  </section>
  <section
    class="bg-primary-bg
    text-primary-text
    font-black
    text-left text-4xl
    py-20 px-2 leading-16
    lg:px-48
   
      lg:text-6xl"
  >
    <AnimatedHeroText client:load />
  </section>
</div>
