---
import { projects } from '../data/projects';
import ProjectCard from '../components/ProjectCard.astro';
---

<div
  id={Astro.props.id}
  class="w-4/5 max-w-screen-2xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8"
>
  {
    projects.map((project) => (
      <ProjectCard
        card={project.images.card}
        alt={project.alt}
        techStack={project.techStack}
        name={project.name}
        id={project.id}
        services={project.services}
      />
    ))
  }
</div>
