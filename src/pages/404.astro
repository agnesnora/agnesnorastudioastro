---
import Layout from '../layouts/Layout.astro';

const title = '404 | Agnesnora Studio';
const description =
  'Webfejlesztés, webapp-ok, dashboardok, weboldalak audit Next.js, Astro, React, Tailwind, SCSS technológiákkal.';
const canonical = 'https://agnesnorastudio.hu/szolgaltatasok';
---

<Layout {title} {description} {canonical}>
  <section class="h-screen flex flex-col justify-center max-w-7xl mx-auto px-4">
    <h2
      class="font-family-space font-bold text-3xl text-center lg:text-4xl xl:text-5xl"
    >
      Sajnálom, a keresett oldal nem található!
    </h2>
  </section>
</Layout>
