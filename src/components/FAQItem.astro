---
const { question, answer } = Astro.props;
---

<details class="group p-5">
  <summary
    class="flex cursor-pointer text-primary-text list-none items-center justify-between gap-4 font-family-inter text-md lg:text-lg font-medium"
  >
    {question}
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      ><path
        fill="var(--color-sage-bg-dark)"
        d="M18 12.998h-5v5a1 1 0 0 1-2 0v-5H6a1 1 0 0 1 0-2h5v-5a1 1 0 0 1 2 0v5h5a1 1 0 0 1 0 2"
      ></path></svg
    >
  </summary>

  <p class="mt-3 text-md leading-relaxed text-primary-text">
    {answer}
  </p>
</details>
